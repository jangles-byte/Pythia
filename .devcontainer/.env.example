# Copied to .devcontainer/.env (gitignored) on first open. Loaded into the app, not the dev container.

# Ports on this Mac. 3000 is left free for other projects.
UI_PORT=3010
ENGINE_HOST_PORT=8088

# The oracle's brain: Ollama running on the Mac (open the Ollama app, or `ollama serve`).
# Any model from `ollama list` works.
LLM_MODEL=qwen3:14b
# LLM_BASE_URL=http://host.docker.internal:11434/v1

# Osiris commit the overlay is applied to. The overlay was written against Osiris from
# mid-July 2026; newer Osiris has moved on and the overlay may not fit.
OSIRIS_REF=f3534cd

# Other engine settings (horizons, swarm, brief time...) can go here too;
# see the repo's .env.example for the full list.
